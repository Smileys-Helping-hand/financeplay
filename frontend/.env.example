# Database connection - PostgreSQL (REQUIRED)
# Get a free PostgreSQL database from: https://neon.tech or https://supabase.com
# Example: postgresql://username:password@host:port/database
DATABASE_URL="postgresql://user:password@localhost:5432/financeplay"

# OpenAI API Key (OPTIONAL)
# If not set, AI coach will use fallback responses
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-your-openai-api-key-here"

# Note: NEXT_PUBLIC_API_URL is no longer needed!
# The frontend and backend are now unified in a single deployment.
# All API routes are available at /api/* on the same domain.
