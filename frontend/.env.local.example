# ──────────────────────────────────────────────────────────────────────────
# Database
# ──────────────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/financeplay"

# ──────────────────────────────────────────────────────────────────────────
# Email Service - Choose ONE of: Resend, SendGrid, or SMTP
# ──────────────────────────────────────────────────────────────────────────

# Resend (Recommended for Next.js) - https://resend.com
RESEND_API_KEY="re_1234567890abcdef"

# SendGrid - https://sendgrid.com
# SENDGRID_API_KEY="SG.1234567890abcdef"

# Email configuration
NEXT_PUBLIC_SENDER_EMAIL="noreply@familywealthcustodians.co.za"
NEXT_PUBLIC_ADMIN_EMAIL="info@familywealthcustodians.co.za"

# ──────────────────────────────────────────────────────────────────────────
# Calendar & Scheduling (Phase 3.2)
# ──────────────────────────────────────────────────────────────────────────

# Cal.com - https://cal.com
# CALCOM_API_KEY="your-api-key"
# CALCOM_USERNAME="family-wealth-custodians"

# Calendly - https://calendly.com
# CALENDLY_API_TOKEN="your-api-token"
# CALENDLY_EVENT_TYPE_UUID="your-event-uuid"

# Google Calendar (for Zoom links)
# GOOGLE_CALENDAR_ID="your-calendar-id@gmail.com"
# GOOGLE_CALENDAR_API_KEY="your-api-key"

# Zoom
# ZOOM_ACCOUNT_ID="your-account-id"
# ZOOM_CLIENT_ID="your-client-id"
# ZOOM_CLIENT_SECRET="your-client-secret"

# ──────────────────────────────────────────────────────────────────────────
# CRM Integration (Phase 3.3)
# ──────────────────────────────────────────────────────────────────────────

# Salesforce - https://salesforce.com
# SALESFORCE_INSTANCE_URL="https://your-instance.salesforce.com"
# SALESFORCE_CLIENT_ID="your-client-id"
# SALESFORCE_CLIENT_SECRET="your-client-secret"
# SALESFORCE_USERNAME="your-username"
# SALESFORCE_PASSWORD="your-password"

# HubSpot - https://hubspot.com
# HUBSPOT_API_KEY="pat-na1-your-api-key"
# HUBSPOT_PORTAL_ID="your-portal-id"

# ──────────────────────────────────────────────────────────────────────────
# Analytics & Monitoring (Phase 3.4)
# ──────────────────────────────────────────────────────────────────────────

# Google Analytics
# NEXT_PUBLIC_GA_ID="GA-123456789"

# Mixpanel
# NEXT_PUBLIC_MIXPANEL_TOKEN="your-token"

# Sentry (Error tracking)
# SENTRY_AUTH_TOKEN="your-auth-token"
# SENTRY_ORG="your-org"
# SENTRY_PROJECT="your-project"

# ──────────────────────────────────────────────────────────────────────────
# Firebase (Legacy - used by existing features)
# ──────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY="your-api-key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-bucket"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="your-sender-id"
NEXT_PUBLIC_FIREBASE_APP_ID="your-app-id"

# ──────────────────────────────────────────────────────────────────────────
# Environment
# ──────────────────────────────────────────────────────────────────────────
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3005"
